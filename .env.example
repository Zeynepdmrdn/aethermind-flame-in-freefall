# Copy this file to .env for local use (copy .env.example .env). NEVER commit .env.
# On a deployment host, set these as environment variables / secrets instead of using a file.

# ---- Which model writes the "Generate cited answer" text? ----
# ollama    = free local model on this computer (needs Ollama installed and the model pulled). No API key. Nothing leaves the machine.
# anthropic = paid Anthropic API (needs ANTHROPIC_API_KEY below). This is the default if SYNTH_PROVIDER is not set.
SYNTH_PROVIDER=ollama

# ---- Local model (SYNTH_PROVIDER=ollama) ----
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://127.0.0.1:11434

# ---- Paid API (SYNTH_PROVIDER=anthropic). Placeholder only; never paste a real key into a committed file. ----
# ANTHROPIC_API_KEY=your-key-here
# Optional. Default is claude-opus-5-5. A smaller, cheaper model (for example claude-haiku-5-5) also works for short answers.
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- Optional tuning ----
# PORT=3000
# SYNTH_TIMEOUT_MS=90000       # abort the AI call after this many ms (default 90000 for ollama, 20000 for anthropic)
# RATE_LIMIT_MAX=8             # answers per client per window
# RATE_LIMIT_WINDOW_MS=600000  # window length (10 minutes)
# DAILY_CAP=300                # total answers per day across all clients
# TRUST_PROXY=1                # set to 1 only behind a proxy that appends to X-Forwarded-For (Render, Railway, Fly)
